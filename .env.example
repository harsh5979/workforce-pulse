# Environment Variables — Template
# Copy this to .env and fill in real values
# NEVER commit .env to git

# ─── Database ──────────────────────────────────────
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/workforce
POSTGRES_PASSWORD=changeme

# ─── OpenRouter AI ─────────────────────────────────
# Get free key at: https://openrouter.ai (no credit card needed)
OPENROUTER_API_KEY=sk-or-

# ─── Backend ───────────────────────────────────────
PORT=4000
NODE_ENV=development
SITE_URL=http://localhost:3000

# ─── Frontend ──────────────────────────────────────
# NOTE: NEXT_PUBLIC_ vars are exposed in the browser bundle
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── GitHub Actions Secrets (set in repo settings) ─
# SERVER_HOST     = your.server.ip
# SERVER_USER     = ubuntu
# SERVER_SSH_KEY  = -----BEGIN OPENSSH PRIVATE KEY-----...
