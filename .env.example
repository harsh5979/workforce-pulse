# Environment Variables — Template
# Copy this to .env and fill in real values
# NEVER commit .env to git

# ─── Database ──────────────────────────────────────
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/workforce
POSTGRES_PASSWORD=changeme

# ─── AI Providers ──────────────────────────────────
# ✅ RECOMMENDED: Groq — free, ultra-fast LPU inference
#    Get a key at https://console.groq.com → API Keys
#    Key MUST start with "gsk_" for auto-detection to work
#    Models used: llama-3.3-70b-versatile → llama-3.1-8b-instant → gemma2-9b-it
GROQ_API_KEY=gsk_YOUR_KEY_HERE

# ⚠️  Fallback only: OpenRouter free-tier (slower, rate-limited)
#    Get a key at https://openrouter.ai → Keys
OPENROUTER_API_KEY=sk-or-YOUR_KEY_HERE

# ─── Backend ───────────────────────────────────────
PORT=4000
NODE_ENV=development
SITE_URL=http://localhost:3000

# ─── Frontend ──────────────────────────────────────
# NOTE: NEXT_PUBLIC_ vars are exposed in the browser bundle
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── GitHub Actions Secrets (set in repo settings) ─
# SERVER_HOST     = your.server.ip
# SERVER_USER     = ubuntu
# SERVER_SSH_KEY  = -----BEGIN OPENSSH PRIVATE KEY-----...
